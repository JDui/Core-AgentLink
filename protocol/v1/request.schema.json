{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C-AL v1 request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "sessionId", "projectId", "token", "command", "payload"],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  },
  "properties": {
    "version": {"const": 1},
    "id": {"$ref": "#/$defs/uuid"},
    "sessionId": {"$ref": "#/$defs/uuid"},
    "projectId": {"type": "string", "minLength": 1, "maxLength": 128},
    "token": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command": {"enum": ["identify", "inspect", "log", "events", "cleanup", "cancel", "apply", "undo", "finish"]},
    "payload": {"type": "object"}
  }
}

