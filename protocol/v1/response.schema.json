{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C-AL v1 transport response (CLI output is a separate envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "ok", "result", "error"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "ok": {"type": "boolean"},
    "result": {},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"ok": {"const": true}}},
      "then": {"properties": {"error": {"type": "null"}}},
      "else": {"properties": {"result": {"type": "null"}, "error": {"type": "object"}}}}
  ]
}

